msgstr "Kopier config.php til application/config/"

#: install/run.php:38
msgid "Copy database.php to application/config/"
msgstr "Kopier database.php til application/config/"

#: install/run.php:41
msgid "Creating database tables"
msgstr "Oppretter databasetabeller"

#: install/run.php:44
msgid "Running database migrations"
msgstr "Utfører databasemigrering"

#: install/run.php:47
msgid "Updating DXCC data"
